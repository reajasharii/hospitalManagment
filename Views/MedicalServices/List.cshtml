@model IEnumerable<HospitalManagement.Models.MedicalService>

@{
    ViewData["Title"] = "Medical Services List";
}

<h1>Medical Services</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Duration</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var service in Model)
        {
            <tr>
                <td>@service.Name</td>
                <td>@service.Description</td>
                <td>@service.Price</td>
                <td>@service.Duration</td>
                <td>@service.Category</td>
                <td>
                    <a href="@Url.Action("Details", "MedicalServices", new { id = service.Id })">Details</a> |

                </td>
            </tr>
        }
    </tbody>
</table>

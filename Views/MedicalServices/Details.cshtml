@model HospitalManagement.Models.MedicalService

@{
    ViewData["Title"] = "Medical Service Details";
}

<h1>Details for @Model.Name</h1>

<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Price:</strong> @Model.Price</p>
<p><strong>Duration:</strong> @Model.Duration</p>
<p><strong>Category:</strong> @Model.Category</p>
<p><strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd")</p>

<a href="@Url.Action("List", "MedicalServices")">Back to List</a>
